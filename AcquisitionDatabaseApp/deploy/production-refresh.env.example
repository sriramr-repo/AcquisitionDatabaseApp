# Refresh-host secrets only. Do not copy this file into Vercel.
# Copy to deploy/production-refresh.env, fill server-side values, then run:
# chmod 600 deploy/production-refresh.env
# Required migration/application identity; must match publisher host/database.
DATABASE_URL=
PUBLISHER_DATABASE_URL=
# Credential-free SHA-256 emitted by production-refresh.sh --print-target-fingerprint.
# Verify the redacted host/database against the provider and Vercel production
# DATABASE_URL before approving this value.
SCM_PRODUCTION_DATABASE_FINGERPRINT=
# Optional. Leave empty for latest-manifest mode. The first canonical activation
# should use the reviewed repository manifest shown below.
IAPD_FIRM_ACTIVATION_MANIFEST=/ABSOLUTE/PATH/TO/AcquisitionDatabaseApp/deploy/iapd-firm-activations/iapdfirm20261107.json
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Optional, for short-lived Cloudflare R2 credentials.
CLOUDFLARE_R2_SESSION_TOKEN=
IAPD_R2_UPLOAD_WORKERS=16
IAPD_LIVE_BATCH_SIZE=25
IAPD_LIVE_WORKERS=1
IAPD_LIVE_FRESHNESS_DAYS=30
FIRECRAWL_API_KEY=
# Virtual SDR artifacts use the same R2 credentials when the LangGraph deployment is configured.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scm-virtual-sdr
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
VIRTUAL_SDR_PROVIDER=openai
VIRTUAL_SDR_MODEL=gpt-4.1-mini
