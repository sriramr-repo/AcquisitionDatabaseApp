# Copy to deploy/production-refresh.env, fill server-side values, then run:
# chmod 600 deploy/production-refresh.env
PUBLISHER_DATABASE_URL=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Optional, for short-lived Cloudflare R2 credentials.
CLOUDFLARE_R2_SESSION_TOKEN=
IAPD_R2_UPLOAD_WORKERS=16
# Virtual SDR artifacts use the same R2 credentials when the LangGraph deployment is configured.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scm-virtual-sdr
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
VIRTUAL_SDR_PROVIDER=openai
VIRTUAL_SDR_MODEL=gpt-4.1-mini
