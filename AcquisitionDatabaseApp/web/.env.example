DATABASE_URL=postgres://scm:scm@localhost:5432/scm_dashboard
# Vercel production/preview deployment gates. Fingerprints are credential-free
# hashes of the normalized host, port, database, and public schema. Vercel must
# use a pooled Neon hostname; migrations and recovery use separate direct URLs.
SCM_PRODUCTION_DATABASE_FINGERPRINT=
SCM_NEON_PROJECT_ID=
SCM_MUTATIONS_ENABLED=false
AUTH_SECRET=replace-with-a-long-random-value
AUTH_TRUST_HOST=true
AUTH_DEV_EMAIL=analyst@example.com
AUTH_DEV_PASSWORD_HASH=replace-with-bcrypt-hash
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
# LangSmith Cloud tracing and durable LangGraph execution (server-side only).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scm-virtual-sdr
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGGRAPH_DEPLOYMENT_URL=
LANGGRAPH_ASSISTANT_ID=virtual_sdr
VIRTUAL_SDR_PROVIDER=openai
VIRTUAL_SDR_MODEL=gpt-4.1-mini
VIRTUAL_SDR_TIMEOUT_SECONDS=120
VIRTUAL_SDR_MAX_TOKENS=4000
RESEARCH_AGENT_PROVIDER=ollama
RESEARCH_AGENT_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
FREETOKEN_BASE_URL=http://127.0.0.1:1919/v1
FREETOKEN_API_KEY=
RESEARCH_AGENT_PROVIDER_HEALTH_TIMEOUT_SECONDS=5
RESEARCH_AGENT_MAX_PAGES=6
RESEARCH_AGENT_MAX_TOKENS=700
RESEARCH_AGENT_TIMEOUT_SECONDS=60
RESEARCH_AGENT_MAX_CONTENT_CHARS=120000
RESEARCH_AGENT_MAX_CHUNK_CHARS=6000
RESEARCH_AGENT_MAX_CHUNKS=8
RESEARCH_AGENT_MAX_CHUNKS_PER_REQUEST=1
RESEARCH_AGENT_MAX_ATTEMPTS=3
RESEARCH_AGENT_RETRY_BASE_SECONDS=15
RESEARCH_AGENT_LEASE_SECONDS=600
ADV_CUSTODIAN_LANGCHAIN_ENABLED=false
ADV_CUSTODIAN_PROVIDER=ollama
ADV_CUSTODIAN_MODEL=qwen3:8b
ADV_CUSTODIAN_TIMEOUT_SECONDS=60
ADV_CUSTODIAN_MAX_CONTENT_CHARS=50000
ADV_OCR_MAX_PAGES=250
ADV_OCR_LEASE_SECONDS=3600
SCM_ENV=PROD
SCM_DATA_DIR=/Users/sriramramanan/GitHub/AcquisitionDatabaseApp/data
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLOUDFLARE_R2_ACCOUNT_ID=
# Vercel/server routes use a separately scoped read-only R2 credential.
CLOUDFLARE_R2_READ_ACCESS_KEY_ID=
CLOUDFLARE_R2_READ_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_READ_SESSION_TOKEN=
CLOUDFLARE_R2_BUCKET=
# Local refresh-host compatibility only. These names are rejected by the
# Vercel preflight because they may carry write access.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional, for short-lived Cloudflare R2 credentials.
CLOUDFLARE_R2_SESSION_TOKEN=
IAPD_BUNDLE_CACHE_TTL_SECONDS=300
IAPD_BUNDLE_CACHE_MAX_ENTRIES=250
IAPD_BUNDLE_CACHE_MAX_BYTES=50000000
IAPD_R2_TIMEOUT_MS=8000
IAPD_R2_MAX_MANIFEST_BYTES=25000000
IAPD_R2_MAX_BUNDLE_BYTES=5000000
IAPD_R2_MAX_EXPANDED_BUNDLE_BYTES=25000000
