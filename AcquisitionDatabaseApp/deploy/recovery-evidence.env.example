# Operator-only recovery evidence settings. Do not load this file in Vercel or
# the scheduled refresh. Copy to an ignored mode-600 file before use.
# Absolute directory containing pg_dump, pg_restore, and psql. Homebrew's
# keg-only libpq package installs them here on Apple Silicon.
SCM_POSTGRES_BIN_DIR=/opt/homebrew/opt/libpq/bin
DATABASE_URL=
SCM_PRODUCTION_DATABASE_FINGERPRINT=
# Must identify an empty, separately approved PostgreSQL database or provider
# branch. The recovery tool refuses the production identity and any non-empty
# public/drizzle target.
RECOVERY_RESTORE_DATABASE_URL=
