<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scm.ria.production-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/ABSOLUTE/PATH/TO/AcquisitionDatabaseApp/deploy/production-refresh.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Day</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TO/AcquisitionDatabaseApp/data/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/AcquisitionDatabaseApp/data/logs/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SCM_PYTHON</key><string>/ABSOLUTE/PATH/TO/python3</string>
    <key>PUBLISHER_DATABASE_URL</key><string>postgres://scm:scm@localhost:5432/scm_dashboard</string>
  </dict>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
