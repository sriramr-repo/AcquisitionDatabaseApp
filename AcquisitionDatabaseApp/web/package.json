{
  "name": "scm-ria-acquisition-dashboard",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel:preflight": "node --experimental-strip-types scripts/vercel-preflight.ts",
    "vercel:build": "npm run vercel:preflight && npm run build",
    "test:deployment": "node --test tests/deployment-policy.test.cjs",
    "test:preferences": "node --experimental-strip-types --test tests/target-column-preferences.test.mjs",
    "test:shortlist": "node --test tests/analyst-shortlist.test.cjs tests/outreach-policy.test.cjs",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "auth:create-analyst": "node scripts/create-analyst.mjs",
    "publisher:sync": "python3 -m src.dashboard_publisher publish --dataset-version ia07012026 --database-url \"$DATABASE_URL\""
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/functions": "^2.2.12",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.29",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
